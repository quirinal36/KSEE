<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  챗봇 전용 게시판 매퍼.
  기존 board_sql 과 달리 모든 사용자 입력을 #{} (PreparedStatement 바인딩) 으로 처리하여
  SQL Injection 및 작은따옴표(') 등 특수문자로 인한 쿼리 오류를 방지한다.
-->
<mapper namespace="chatbot_board_sql">

	<insert id="insert" parameterType="board" useGeneratedKeys="true" keyProperty="id">
		INSERT INTO Board (title, title_en, content, writer, boardType)
		VALUES (#{title}, #{title_en}, #{content}, #{writer}, #{boardType})
	</insert>

	<update id="update" parameterType="board">
		UPDATE Board
		<set>
			<if test="title != null">title = #{title},</if>
			<if test="title_en != null">title_en = #{title_en},</if>
			<if test="content != null">content = #{content},</if>
		</set>
		<where>
			id = #{id}
		</where>
	</update>

	<delete id="delete" parameterType="board">
		DELETE FROM Board
		<where>
			id = #{id}
		</where>
	</delete>

</mapper>
