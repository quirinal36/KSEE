# DB 접속 설정 템플릿. 실제 값은 커밋하지 마세요.
# 주입 우선순위: 환경변수 > db.properties
#   환경변수(권장): MYSQL_DRIVER, MYSQL_JDBC_URL, MYSQL_USERNAME, MYSQL_PASSWORD
mysql.driver=com.mysql.cj.jdbc.Driver
mysql.jdbcUrl=jdbc:mysql://DB_HOST:3306/DB_NAME?useSSL=true&serverTimezone=UTC
mysql.username=YOUR_DB_USER
mysql.password=YOUR_DB_PASSWORD
